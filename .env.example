# Copy this file to .env and fill in values before first start.
PORT=3000
HOST_PORT=3000
NODE_ENV=production
DATA_DIR=/app/data
MAX_UPLOAD_MB=10
METRICS_TOKEN=

# Generate a strong value with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# If omitted, the app creates and stores a private key in DATA_DIR/.jwt_secret.
JWT_SECRET=

# Used only when DATA_DIR has no existing staff accounts. Remove after first start.
INITIAL_OWNER_USERNAME=
INITIAL_OWNER_PASSWORD=

# Google Identity Services
GOOGLE_CLIENT_ID=

# Configure either a refresh token or service account credentials for Google Drive.
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
DRIVE_OWNER_EMAIL=

# Optional OAuth callback helper; leave false unless setting up Google auth.
ENABLE_AUTH_SETUP=false
